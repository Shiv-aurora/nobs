NOPING_DEMO_MODE=true
NOPING_AI_ENABLED=true
NOPING_SERVICE_SIGNING_SECRET=replace-me
NOPING_MAX_USER_PER_MINUTE=3
NOPING_MAX_USER_PER_HOUR=20
NOPING_MAX_USER_PER_DAY=20
NOPING_MAX_ORG_PER_MINUTE=10
NOPING_MAX_ORG_PER_DAY=60
NOPING_MAX_CONCURRENT_RUNS=2

# Structured logs are written to stdout and ingested automatically by Cloud Run.
NOPING_LOG_LEVEL=INFO
OTEL_SERVICE_NAME=noping-agent-service
# Optional: point this at an OTLP/HTTP collector. Leave empty for hackathon cost control.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Model Armor screens only the latest user input and the final model response.
NOPING_MODEL_ARMOR_ENABLED=false
NOPING_MODEL_ARMOR_LOCATION=us-central1
NOPING_MODEL_ARMOR_TEMPLATE_ID=noping-enterprise-guard
NOPING_MODEL_ARMOR_FAIL_CLOSED=true
