NOPING_DEMO_MODE=true
NOPING_AI_ENABLED=true
NOPING_GEMINI_MODEL=gemini-3.5-flash
NOPING_ACTION_COMMAND_TOPIC=noping-action-commands
NOPING_AGENT_REGISTRY_ENABLED=false
NOPING_AGENT_REGISTRY_LOCATION=global
NOPING_AGENT_ENGINE_ID=
NOPING_AGENT_ENGINE_LOCATION=us-central1
NOPING_SERVICE_SIGNING_SECRET=replace-me
NOPING_MAX_USER_PER_MINUTE=6
NOPING_MAX_USER_PER_HOUR=40
NOPING_MAX_USER_PER_DAY=80
NOPING_MAX_ORG_PER_MINUTE=20
NOPING_MAX_ORG_PER_DAY=200
NOPING_MAX_CONCURRENT_RUNS=2
NOPING_LIVE_MODEL=gemini-live-2.5-flash-native-audio
NOPING_LIVE_LOCATION=us-central1
NOPING_LIVE_MAX_CONCURRENT_SESSIONS=1
NOPING_LIVE_MAX_SESSION_MINUTES=15
NOPING_LIVE_MAX_ORG_MINUTES_PER_DAY=60
NOPING_LIVE_MAX_TOOL_CALLS_PER_SESSION=24
NOPING_LIVE_MAX_RECONNECT_ATTEMPTS=5

# Structured logs are written to stdout and ingested automatically by Cloud Run.
NOPING_LOG_LEVEL=INFO
OTEL_SERVICE_NAME=noping-agent-service
# Optional: point this at an OTLP/HTTP collector. Leave empty for hackathon cost control.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Model Armor screens only the latest user input and the final model response.
NOPING_MODEL_ARMOR_ENABLED=false
NOPING_MODEL_ARMOR_LOCATION=us-central1
NOPING_MODEL_ARMOR_TEMPLATE_ID=noping-enterprise-guard
NOPING_MODEL_ARMOR_FAIL_CLOSED=true
