flowchart LR
  classDef exec fill:#e8f0fe,stroke:#1a73e8,color:#174ea6
  classDef deterministic fill:#e6f4ea,stroke:#188038,color:#137333
  classDef state fill:#fef7e0,stroke:#f9ab00,color:#7a4d00
  classDef write fill:#fce8e6,stroke:#d93025,color:#a50e0e
  classDef human fill:#f3e8fd,stroke:#9334e6,color:#681da8
  classDef future fill:#fff,stroke:#777,color:#555,stroke-dasharray: 7 5

  subgraph A["A · Experience + collaboration"]
    direction TB
    U["Employee"] --> UI["NoBS React UI"]
    UI <-->|"HTTPS · WebSocket"| MM["Mattermost + Caddy"]
    MM <-->|"collaboration truth"| PG[("PostgreSQL")]
    MM <-->|"server-side identity"| PL["NoBS Go plugin"]
    BUD["$25 budget + independent guard<br/>may stop only this demo VM"]
  end

  subgraph B["B · Private gateway · read-only"]
    direction TB
    GW["NoBS Gateway<br/>IAM · HMAC · replay"]
    ADM["rate · concurrency<br/>call + token admission"]
    DD["Delegate Directory<br/>logical identities"]
    AG["Access Gate<br/>tenant · scope · evidence"]
    MA["Model Armor<br/>fail closed"]
    WE["Pub/Sub work events<br/>OIDC · retry · DLQ"]
    GW --> ADM --> AG --> MA
    DD --> AG
    WE --> GW
  end

  PL -->|"sync signed request<br/>+ trace context"| GW
  subgraph C["C · Durable governed mission"]
    direction TB
    REG["Agent Registry<br/>4 versioned services"]
    MC["Mission Controller<br/>ADK · Gemini 3.5"]
    WG["Work Graph Agent<br/>ADK · Gemini 3.5"]
    PE["Policy Evidence Agent<br/>ADK · Gemini 3.5"]
    EC["Evidence Critic<br/>deterministic"]
    MR["Meeting Resolution<br/>ADK · Gemini 3.5"]
    BG["Business Decision Gate<br/>PolicyEngine · deterministic"]
    BC["Business checkpoint<br/>Sarah or valid acting Alex"]
    CG["Calendar Action Gate<br/>organizer only"]
    CC["Calendar checkpoint<br/>separate persisted event"]
    FS[("Firestore<br/>mission · steps · checkpoints<br/>commands · attempts · audit")]
    SES["Vertex Sessions<br/>ADK context"]
    MEM["Memory Bank<br/>preferences only · never authority"]
    REG --> MC
    MC -->|"parallel"| WG
    MC -->|"parallel"| PE
    WG --> EC
    PE --> EC
    EC --> MR --> BG
    BG -->|"authority required"| BC
    BG -->|"no business gate"| CG
    BC -->|"approved · same mission"| CG
    BG -->|"no action"| FS
    CG --> CC
    BC <-->|"durable resolution"| FS
    CC <-->|"durable resolution"| FS
    SES <-->|"ADK events"| MC
  end

  subgraph D["D · Consequential actions"]
    direction TB
    CB["Command builder<br/>approved live source only"]
    OUT[("approved command outbox")]
    CQ["Pub/Sub command ID<br/>OIDC · retry · DLQ"]
    EX["Private Action Executor<br/>separate SA · max 1"]
    CAL["Google Calendar<br/>external truth"]
    RV["ETag + result verifier<br/>persist hashed outcome"]
    OBS["Logging · Trace · Monitoring"]
    FUT["Agent Gateway · future only<br/>no A2A/MCP hop today"]
    CB --> OUT --> CQ --> EX
    EX -->|"If-Match write"| CAL
    CAL -->|"post-write read"| RV
    EX --> OBS
  end

  CC -->|"approved live source"| CB
  MA --> MC

  class MC,WG,PE,MR exec
  class ADM,AG,EC,BG,CG,CB,RV deterministic
  class FS,PG,OUT,WE,CQ,REG,SES,MEM state
  class EX,CAL write
  class BC,CC human
  class FUT future
